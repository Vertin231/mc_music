{
  "schemaVersion": 1,
  "id": "midipack",
  "version": "${version}",
  "name": "MIDI Pack",
  "description": "Import MIDI files and generate Minecraft datapacks with playsound or note-block playback.",
  "authors": ["mc_music contributors"],
  "environment": "*",
  "entrypoints": {
    "main": ["com.example.midipack.MidiPackMod"],
    "client": ["com.example.midipack.client.MidiPackClient"]
  },
  "depends": {
    "fabricloader": ">=0.15.0",
    "minecraft": "1.20.4",
    "java": ">=17",
    "fabric-api": "*"
  }
}
